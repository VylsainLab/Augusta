#version 450
#extension GL_EXT_debug_printf : enable
#extension GL_ARB_gpu_shader_int64 : enable

#include "Utils.header"

//INPUTS
layout(location = 0) in vec3 fragNormal;
layout(location = 1) in vec2 fragTexcoord;
layout(location = 2) in vec3 fragPos;

//OUTPUTS
layout(location = 0) out vec4 outAlbedo;
layout(location = 1) out vec4 outNormals;
layout(location = 2) out vec4 outRoughMetalAO;

//MATERIAL
#define TEXTURE_CHANNEL_ALBEDO_BIT		1
#define TEXTURE_CHANNEL_NORMAL_BIT		2
#define TEXTURE_CHANNEL_AO_BIT			4
#define TEXTURE_CHANNEL_ROUGHNESS_BIT	8
#define TEXTURE_CHANNEL_METALNESS_BIT	16
#define TEXTURE_CHANNEL_EMISSIVE_BIT	32

layout(set=1, binding = 0) uniform UniformBufferObject 
{
	vec4 _Albedo;
	uint64_t _uiAddress;
    float _fOpacity;
	float _fRoughness;
	float _fMetalness;
	uint _iTexMask;
} materialUBO;

layout(set=1, binding = 1) uniform sampler2D samplerAlbedo;
layout(set=1, binding = 2) uniform sampler2D samplerNormal;
layout(set=1, binding = 3) uniform sampler2D samplerAO;
layout(set=1, binding = 4) uniform sampler2D samplerRoughness;
layout(set=1, binding = 5) uniform sampler2D samplerMetalness;
layout(set=1, binding = 6) uniform sampler2D samplerEmissive;

void main() 
{
	//debugPrintfEXT("Material mask: %lx %d %d", materialUBO._uiAddress, materialUBO._iTexMask, bNormal);

	bool bAlbedoMap =		(materialUBO._iTexMask & TEXTURE_CHANNEL_ALBEDO_BIT)==TEXTURE_CHANNEL_ALBEDO_BIT;
	bool bNormalMap =		(materialUBO._iTexMask & TEXTURE_CHANNEL_NORMAL_BIT)==TEXTURE_CHANNEL_NORMAL_BIT;
	bool bAOMap =			(materialUBO._iTexMask & TEXTURE_CHANNEL_AO_BIT)==TEXTURE_CHANNEL_AO_BIT;
	bool bRoughnessMap =	(materialUBO._iTexMask & TEXTURE_CHANNEL_ROUGHNESS_BIT)==TEXTURE_CHANNEL_ROUGHNESS_BIT;
	bool bMetalnessMap =	(materialUBO._iTexMask & TEXTURE_CHANNEL_METALNESS_BIT)==TEXTURE_CHANNEL_METALNESS_BIT;
	bool bEmissiveMap =		(materialUBO._iTexMask & TEXTURE_CHANNEL_EMISSIVE_BIT)==TEXTURE_CHANNEL_EMISSIVE_BIT;

    vec3 albedo = bAlbedoMap ? texture(samplerAlbedo, fragTexcoord).rgb : materialUBO._Albedo.rgb;
    vec3 normals = bNormalMap ? texture(samplerNormal, fragTexcoord).rgb : fragNormal;
	float ao = bAOMap ? texture(samplerAO, fragTexcoord).r : 1;
	float roughness = bRoughnessMap ? texture(samplerRoughness, fragTexcoord).r : materialUBO._fRoughness;
	float metalness = bMetalnessMap ? texture(samplerMetalness, fragTexcoord).r : materialUBO._fMetalness;
	vec3 emissive = bEmissiveMap ? texture(samplerEmissive, fragTexcoord).rgb : vec3(0.);

    outAlbedo.rgb = albedo;
	outAlbedo.a = 1.0;

	float fBumpiness = 1.0;
    mat3 TBN = cotangent_frame(fragNormal,fragPos,fragTexcoord);
    vec3 N = bNormalMap ? mix(normalize(fragNormal),perturb_normal(TBN,normals),fBumpiness) : normalize(fragNormal);
    outNormals.rgb = N;
	outNormals.a = 1.0;

	outRoughMetalAO.r = roughness.r;
	outRoughMetalAO.g = metalness.r;
	outRoughMetalAO.b = ao.r;
	outRoughMetalAO.a = 1.0;
}