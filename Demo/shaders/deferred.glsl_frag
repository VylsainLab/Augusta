#version 450 core

#include "Lighting.header"

layout(location = 0) in vec2 uv;

layout(location = 0) out vec4 color;

layout(set=0, binding = 0) uniform sampler2D samplerAlbedo;
layout(set=0, binding = 1) uniform sampler2D samplerNormals;
layout(set=0, binding = 2) uniform sampler2D samplerEmissiveAO;

layout(set=1, binding = 0) uniform sampler2D samplerHDRCubemap;

void main()
{  
    SDirectionalLight Sun;
    Sun._fIlluminance = 1.0f;
    Sun._vDirection = vec3(0,1,0);

    vec3 normals = texture(samplerNormals, uv).rgb;
    vec3 diffuse = GetDirectionalLight(Sun,normals) * texture(samplerAlbedo, uv).rgb;

    vec3 emissive = texture(samplerEmissiveAO, uv).rgb;

    color = vec4(diffuse + emissive, 1.0);
}