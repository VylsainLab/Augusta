#version 450 core

#include "Lighting.header"

layout(location = 0) in vec2 uv;

layout(location = 0) out vec4 color;

layout(set=0, binding = 0) uniform UniformBufferObject 
{
    mat4 _view;
    mat4 _proj;
    vec3 _camPos;
} ubo;

layout(set=1, binding = 0) uniform sampler2D samplerAlbedoRoughness;
layout(set=1, binding = 1) uniform sampler2D samplerNormalsMetalness;
layout(set=1, binding = 2) uniform sampler2D samplerEmissiveAO;
layout(set=1, binding = 3) uniform sampler2D samplerDepth;

layout(set=2, binding = 0) uniform sampler2D samplerHDRCubemap;

void main()
{  
    SDirectionalLight Sun;
    Sun._fIlluminance = 1.0f;
    Sun._vDirection = vec3(0,1,0);

    vec3 normals = texture(samplerNormalsMetalness, uv).rgb;
    vec3 diffuse = GetDirectionalLight(Sun,normals) * texture(samplerAlbedoRoughness, uv).rgb;

    vec3 emissive = texture(samplerEmissiveAO, uv).rgb;

    float fDepth = texture(samplerDepth, uv).r;

    color = vec4(diffuse + emissive, 1.0);
}