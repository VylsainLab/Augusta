#version 450 core

layout(location = 0) in vec2 uv;

layout(location = 0) out vec4 color;

layout(set=0, binding = 0) uniform sampler2D samplerHDR;

void main()
{  
    float fGamma = 2.2;
    float fExposure = 1.0;
    vec3 hdrColor = texture(samplerHDR, uv).rgb;

    // Exposure tone mapping
    vec3 mapped = vec3(1.0) - exp(-hdrColor * fExposure);

    // Gamma correction 
    mapped = pow(mapped, vec3(1.0 / fGamma));

    color = vec4(mapped, 1.0);
}